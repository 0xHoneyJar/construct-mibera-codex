{
  "name": "@zksoju/construct-mibera-codex",
  "version": "1.3.0",
  "description": "Mibera Codex CLI + MCP — anti-hallucination lookup (zones, archetypes, factors, grails, miberas) plus intent-layer search via QMD.",
  "type": "module",
  "bin": {
    "codex": "./dist/bin/codex.js",
    "codex-mcp": "./dist/bin/mcp.js"
  },
  "scripts": {
    "build": "tsc",
    "codex": "tsx bin/codex.ts",
    "codex:dev": "tsx watch bin/codex.ts",
    "codex:index": "bash scripts/build-codex-index.sh",
    "mcp": "tsx bin/mcp.ts",
    "mcp:dev": "tsx watch bin/mcp.ts",
    "prepublishOnly": "tsc"
  },
  "files": [
    "bin",
    "dist",
    "construct.yaml",
    "core-lore",
    "grails",
    "_codex/data",
    "_codex/schema",
    "scripts/build-codex-index.sh",
    "skills"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.2",
    "gray-matter": "^4.0.3",
    "zod": "^3.25.28"
  },
  "peerDependencies": {
    "@tobilu/qmd": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@tobilu/qmd": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/0xHoneyJar/construct-mibera-codex.git"
  },
  "license": "MIT"
}
